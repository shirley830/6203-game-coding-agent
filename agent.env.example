# Copy to agent.env in the run directory (next to game_design_prompt.md).
# Never commit or submit agent.env: it contains your API key.
# Course model (GLM-5.3 through OpenRouter):
AGENT_MODEL=openrouter/z-ai/glm-5.3
OPENROUTER_API_KEY=replace-with-the-course-key
# Total run time in seconds (set from the presentation slot; default 1800):
# AGENT_MAX_RUNTIME=1200
# Optional:
# AGENT_MAX_TOKENS=32000
# Reasoning cap (default 8000 for GLM models; 0 disables):
# AGENT_REASONING_MAX_TOKENS=8000
