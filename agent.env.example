# Copy to agent.env in the run directory (next to game_design_prompt.md).
# Never commit or submit agent.env: it contains your API key.
# Course model (Kimi K3 through OpenRouter; GLM-5.3 until October 2026):
AGENT_MODEL=openrouter/moonshotai/kimi-k3
OPENROUTER_API_KEY=replace-with-the-course-key
# Total run time in seconds, including finalization (default 420 = 7 minutes, for the
# 10-minute presentation slot). Change it only if the course allows a different run time:
AGENT_MAX_RUNTIME=420
# Optional:
# AGENT_MAX_TOKENS=32000
# Reasoning cap (default 8000 for GLM and Kimi models; 0 disables):
# AGENT_REASONING_MAX_TOKENS=8000
# Lower cap for step-by-step decisions (default 3000 when the cap above applies):
# AGENT_DECISION_REASONING_MAX_TOKENS=3000

# After configuring the final provider/key on the demo machine:
# python -m agent.preflight --probe-model
# This explicitly makes one billed API call; default preflight is local-only.
